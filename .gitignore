# OS cruft
.DS_Store

# Local plugin settings (never commit real credentials or per-user overrides)
.claude/*.local.md

# Tooling
node_modules/
*.log

# deploy4artifact runtime state (profile registry, known_hosts) must never
# be committed — it belongs in $D4A_HOME (~/.deploy4artifact), not the repo
.deploy4artifact/
